
<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#080b0a">
<meta name="description" content="THE FAMILY – One Family. One Legacy. Eine Vision, mehrere Unternehmen, eine gemeinsame Zukunft.">
<title>THE FAMILY — One Family. One Legacy.</title>

<style>
:root {
  --black: #080b0a;
  --green: #123b2d;
  --gold: #c6a45b;
  --white: #f3f1e9;
  --muted: #a7ada7;
  --purple: #7545a6;
}

* { box-sizing: border-box; }

html {
  scroll-behavior: smooth;
  background: var(--black);
}

body {
  margin: 0;
  background: var(--black);
  color: var(--white);
  font-family: Arial, Helvetica, sans-serif;
  overflow-x: hidden;
}

button, a { font: inherit; }

a {
  color: inherit;
  text-decoration: none;
}

/* CINEMATIC INTRO */

.intro {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: grid;
  place-items: center;
  text-align: center;
  background:
    radial-gradient(ellipse at 50% 65%, #164632 0%, transparent 40%),
    linear-gradient(145deg, #080b0a, #101a16 60%, #080b0a);
  transition: opacity 1s ease, visibility 1s ease;
}

.intro.hidden {
  opacity: 0;
  visibility: hidden;
}

.intro-content {
  padding: 25px;
  animation: appear 1.5s ease both;
}

.intro-kicker {
  color: var(--gold);
  letter-spacing: 5px;
  font-size: 10px;
  text-transform: uppercase;
}

.intro h1 {
  font-size: clamp(38px, 11vw, 76px);
  letter-spacing: 7px;
  margin: 20px 0 10px;
  font-weight: 500;
}

.intro p {
  color: var(--muted);
  letter-spacing: 4px;
  font-size: 11px;
}

.intro-line {
  height: 1px;
  width: 100px;
  margin: 28px auto;
  background: var(--gold);
  animation: expand 2s ease both;
}

.skip {
  position: absolute;
  bottom: 35px;
  left: 50%;
  transform: translateX(-50%);
  border: 1px solid #ffffff40;
  color: var(--white);
  background: transparent;
  padding: 11px 20px;
  border-radius: 30px;
  font-size: 10px;
  letter-spacing: 2px;
  cursor: pointer;
}

/* NAVIGATION */

header {
  position: absolute;
  z-index: 5;
  top: 0;
  width: 100%;
  padding: 23px 7%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid #ffffff12;
}

.logo {
  font-size: 17px;
  letter-spacing: 4px;
  font-weight: 600;
}

.logo span { color: var(--gold); }

nav {
  display: flex;
  gap: 25px;
  align-items: center;
}

nav a {
  font-size: 10px;
  color: #d2d4ce;
  letter-spacing: 1.5px;
  transition: color .3s;
}

nav a:hover { color: var(--gold); }

.menu-button {
  display: none;
  border: 1px solid #ffffff40;
  background: transparent;
  color: white;
  border-radius: 6px;
  padding: 8px 12px;
}

/* HERO */

.hero {
  min-height: 790px;
  height: 100svh;
  max-height: 1050px;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  text-align: center;
  background:
    radial-gradient(ellipse at 50% 75%, #1a543b80, transparent 48%),
    linear-gradient(180deg, #080b0a 0%, #10231b 65%, #080b0a 100%);
}

.hero::before {
  content: "";
  position: absolute;
  inset: 0;
  opacity: .28;
  background-image:
    linear-gradient(#ffffff08 1px, transparent 1px),
    linear-gradient(90deg, #ffffff08 1px, transparent 1px);
  background-size: 65px 65px;
  transform: perspective(450px) rotateX(55deg) scale(1.7);
  transform-origin: bottom;
}

.city {
  position: absolute;
  bottom: 0;
  width: 100%;
  height: 42%;
  display: flex;
  align-items: end;
  justify-content: center;
  gap: 5px;
  opacity: .55;
  pointer-events: none;
}

.building {
  width: 8%;
  max-width: 95px;
  background: linear-gradient(180deg, #1b382c, #080b0a);
  border-top: 1px solid #c6a45b65;
  box-shadow: inset 0 0 20px #c6a45b0b;
  position: relative;
}

.building::after {
  content: "";
  position: absolute;
  inset: 12px 8px;
  background: repeating-linear-gradient(
    180deg,
    #c6a45b45 0px,
    #c6a45b45 2px,
    transparent 2px,
    transparent 14px
  );
  opacity: .5;
}

.hero-content {
  z-index: 2;
  max-width: 760px;
  padding: 30px;
  margin-top: 40px;
  animation: appear 1.5s ease both;
}

.eyebrow {
  color: var(--gold);
  letter-spacing: 5px;
  font-size: 10px;
  text-transform: uppercase;
}

.hero h1 {
  font-size: clamp(43px, 10vw, 91px);
  letter-spacing: clamp(3px, 1.5vw, 12px);
  font-weight: 500;
  margin: 24px 0 13px;
  text-shadow: 0 0 45px #c6a45b20;
}

.tagline {
  color: var(--gold);
  font-size: 12px;
  letter-spacing: 5px;
}

.hero-description {
  color: #c3cbc4;
  font-size: 14px;
  line-height: 1.8;
  max-width: 490px;
  margin: 28px auto;
}

.primary-button {
  display: inline-block;
  padding: 16px 25px;
  border: 1px solid var(--gold);
  color: var(--gold);
  letter-spacing: 2px;
  font-size: 10px;
  transition: .3s;
}

.primary-button:hover {
  background: var(--gold);
  color: var(--black);
}

.scroll-note {
  position: absolute;
  bottom: 25px;
  color: #a7ada7;
  font-size: 9px;
  letter-spacing: 3px;
}

/* GENERAL SECTIONS */

section.content {
  padding: 110px 8%;
  max-width: 1400px;
  margin: auto;
}

.section-label {
  color: var(--gold);
  letter-spacing: 4px;
  font-size: 10px;
  text-transform: uppercase;
}

.section-heading {
  font-size: clamp(30px, 6vw, 52px);
  font-weight: 400;
  letter-spacing: 2px;
  margin: 20px 0;
}

.section-description {
  max-width: 600px;
  color: var(--muted);
  line-height: 1.9;
  font-size: 14px;
}

/* DIVISIONS */

.divisions {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
  margin-top: 50px;
}

.division {
  position: relative;
  min-height: 225px;
  padding: 30px;
  display: flex;
  flex-direction: column;
  justify-content: end;
  overflow: hidden;
  border: 1px solid #ffffff1c;
  background:
    radial-gradient(ellipse at 80% 20%, #1c4935, transparent 65%),
    linear-gradient(145deg, #111c17, #090d0b);
  transition: border-color .3s, transform .3s;
}

.division:hover {
  border-color: var(--gold);
  transform: translateY(-4px);
}

.division-number {
  position: absolute;
  top: 20px;
  right: 24px;
  color: #c6a45b55;
  font-size: 40px;
}

.division h3 {
  font-size: 20px;
  letter-spacing: 3px;
  font-weight: 500;
  margin: 0 0 10px;
}

.division p {
  color: var(--muted);
  font-size: 12px;
  line-height: 1.6;
  margin: 0;
}

.status {
  display: inline-block;
  width: fit-content;
  margin-top: 17px;
  border: 1px solid #c6a45b55;
  color: var(--gold);
  padding: 6px 9px;
  font-size: 8px;
  letter-spacing: 1.5px;
}

/* PHILOSOPHY */

.philosophy {
  text-align: center;
  padding: 115px 20px;
  background:
    radial-gradient(ellipse at center, #173b2b, transparent 70%),
    #080b0a;
  border-top: 1px solid #ffffff12;
  border-bottom: 1px solid #ffffff12;
}

.philosophy h2 {
  font-size: clamp(23px, 5vw, 43px);
  font-weight: 400;
  letter-spacing: 2px;
  line-height: 1.5;
}

.philosophy h2 span { color: var(--gold); }

.philosophy p {
  color: var(--muted);
  font-size: 10px;
  letter-spacing: 4px;
  margin-top: 35px;
}

/* FOOTER */

footer {
  padding: 40px 8%;
  display: flex;
  justify-content: space-between;
  gap: 20px;
  flex-wrap: wrap;
  color: var(--muted);
  font-size: 10px;
  letter-spacing: 1px;
}

footer strong {
  color: var(--white);
  letter-spacing: 3px;
}

/* ANIMATIONS */

@keyframes appear {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes expand {
  from { width: 0; }
  to { width: 100px; }
}

@media (max-width: 650px) {
  header { padding: 19px 6%; }
  .menu-button { display: block; }
  nav {
    display: none;
    position: absolute;
    top: 65px;
    left: 0;
    right: 0;
    padding: 25px;
    background: #080b0a;
    border-bottom: 1px solid #ffffff20;
    flex-direction: column;
    align-items: flex-start;
  }
  nav.open { display: flex; }
  .hero { min-height: 690px; }
  .hero h1 { letter-spacing: 4px; }
  .tagline { letter-spacing: 3px; }
  .divisions { grid-template-columns: 1fr; }
  section.content { padding: 80px 7%; }
  .division { min-height: 190px; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    scroll-behavior: auto !important;
    animation-duration: .01ms !important;
    transition-duration: .01ms !important;
  }
}
</style>
</head>

<body>

<div class="intro" id="intro">
  <div class="intro-content">
    <div class="intro-kicker">A NEW VISION BEGINS</div>
    <h1>THE FAMILY</h1>
    <p>ONE FAMILY. ONE LEGACY.</p>
    <div class="intro-line"></div>
  </div>
  <button class="skip" id="skipIntro">ENTER THE WORLD</button>
</div>

<header>
  <a href="#" class="logo">THE <span>FAMILY</span></a>
  <button class="menu-button" id="menuButton" aria-label="Menü öffnen">MENU</button>
  <nav id="navigation">
    <a href="#world">OUR WORLD</a>
    <a href="#divisions">DIVISIONS</a>
    <a href="#philosophy">OUR PHILOSOPHY</a>
  </nav>
</header>

<main>
  <section class="hero" id="world">
    <div class="city" aria-hidden="true">
      <div class="building" style="height:42%"></div>
      <div class="building" style="height:65%"></div>
      <div class="building" style="height:48%"></div>
      <div class="building" style="height:82%"></div>
      <div class="building" style="height:57%"></div>
      <div class="building" style="height:100%"></div>
      <div class="building" style="height:70%"></div>
      <div class="building" style="height:48%"></div>
      <div class="building" style="height:75%"></div>
      <div class="building" style="height:52%"></div>
    </div>

    <div class="hero-content">
      <div class="eyebrow">WELCOME TO OUR WORLD</div>
      <h1>THE FAMILY</h1>
      <div class="tagline">ONE FAMILY. ONE LEGACY.</div>
      <p class="hero-description">
        Eine Vision. Mehrere Unternehmen.
        Eine gemeinsame Zukunft.
        Willkommen in der Welt von THE FAMILY.
      </p>
      <a href="#divisions" class="primary-button">EXPLORE THE FAMILY</a>
    </div>

    <div class="scroll-note">SCROLL TO DISCOVER</div>
  </section>

  <section class="content" id="divisions">
    <div class="section-label">THE STRUCTURE</div>
    <h2 class="section-heading">OUR WORLD. OUR FUTURE.</h2>
    <p class="section-description">
      THE FAMILY ist als Unternehmensgruppe gedacht.
      Jeder Bereich verfolgt eine eigene Aufgabe.
      Gemeinsam entsteht eine langfristige Vision.
    </p>

    <div class="divisions">
      <article class="division">
        <div class="division-number">01</div>
        <h3>THE GROUP</h3>
        <p>Strategie, Führung und die Entwicklung der Unternehmensgruppe.</p>
        <span class="status">IN DEVELOPMENT</span>
      </article>

      <article class="division">
        <div class="division-number">02</div>
        <h3>THE STUDIOS</h3>
        <p>Medien, kreative Inhalte und professionelle Videoproduktion.</p>
        <span class="status">FIRST BUSINESS CONCEPT</span>
      </article>

      <article class="division">
        <div class="division-number">03</div>
        <h3>THE NETWORK</h3>
        <p>Menschen, Kontakte, Partnerschaften und gemeinsame Projekte.</p>
        <span class="status">IN DEVELOPMENT</span>
      </article>

      <article class="division">
        <div class="division-number">04</div>
        <h3>THE TECHNOLOGY</h3>
        <p>Digitale Systeme, Automatisierung und technische Entwicklung.</p>
        <span class="status">FUTURE DIVISION</span>
      </article>

      <article class="division">
        <div class="division-number">05</div>
        <h3>THE SCHOOL</h3>
        <p>Lernen, Wissen und persönliche Weiterentwicklung.</p>
        <span class="status">FUTURE DIVISION</span>
      </article>

      <article class="division">
        <div class="division-number">06</div>
        <h3>THE COMMERCE</h3>
        <p>Handel, Vertrieb und zukünftige Geschäftsmodelle.</p>
        <span class="status">FUTURE DIVISION</span>
      </article>

      <article class="division">
        <div class="division-number">07</div>
        <h3>THE IMPACT</h3>
        <p>Gesellschaftliche Projekte und nachhaltiger Mehrwert.</p>
        <span class="status">FUTURE DIVISION</span>
      </article>
    </div>
  </section>

  <section class="philosophy" id="philosophy">
    <div class="section-label">OUR PHILOSOPHY</div>
    <h2>
      BLOOD ISN'T WHAT MAKES A FAMILY.<br>
      <span>LOYALTY IS.</span>
    </h2>
    <p>THE FAMILY · ONE FAMILY. ONE LEGACY.</p>
  </section>
</main>

<footer>
  <strong>THE FAMILY</strong>
  <span>ONE FAMILY. ONE LEGACY.</span>
  <span>© <span id="year"></span> THE FAMILY</span>
</footer>

<script>
const intro = document.getElementById("intro");
const skipIntro = document.getElementById("skipIntro");
const menuButton = document.getElementById("menuButton");
const navigation = document.getElementById("navigation");

function enterWorld() {
  intro.classList.add("hidden");
}

skipIntro.addEventListener("click", enterWorld);

// Automatisch openen na een korte introductie.
const introTimer = window.setTimeout(enterWorld, 3500);

// Mobiele navigatie.
menuButton.addEventListener("click", () => {
  navigation.classList.toggle("open");
});

navigation.querySelectorAll("a").forEach(link => {
  link.addEventListener("click", () => {
    navigation.classList.remove("open");
  });
});

// Aktuelles Jahr im Footer.
document.getElementById("year").textContent =
  new Date().getFullYear();
</script>

</body>
</html>
